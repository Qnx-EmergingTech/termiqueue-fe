{
  "expo": {
    "name": "Qnext",
    "slug": "TermiQueue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoAPP.png",
    "scheme": "termiqueue",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qymera.qnext",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
          "googleMapsApiKey": "AIzaSyCCqG1urGsVMYo1yP6hKHKl0zEeNUKAvtw"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby terminals and track your trips.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to show nearby terminals and track your trips.",
        "NSCameraUsageDescription": "This app needs access to your camera to scan QR codes.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logoAPP.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.qymera.qnext",
      "useNextNotificationsApi": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCCqG1urGsVMYo1yP6hKHKl0zEeNUKAvtw"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "./plugins/withModularHeaders",
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "androidNotificationChannelId": "default",
          "androidNotificationChannelName": "Default Notifications"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logoAPP.png",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a1bbd01-676f-4b23-9302-3ae552f9e67f"
      }
    }
  }
}
